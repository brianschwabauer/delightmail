{
	"name": "delightmail",
	"version": "0.1.0",
	"description": "A keyboard-first, ad-free, self-hostable email client on Cloudflare.",
	"type": "module",
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:full": "node scripts/dev.mjs --full",
		"dev:seed": "node scripts/seed.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"secrets": "node scripts/put-secrets.mjs"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261110.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vitest": "^5.1.0",
		"wrangler": "^4.159.0"
	},
	"dependencies": {
		"@delightstack/ai": "^1.1.15",
		"@delightstack/auth": "^1.4.2",
		"@delightstack/components": "^2.1.2",
		"@delightstack/database": "^3.0.2",
		"@delightstack/editor": "^2.0.1",
		"@delightstack/images": "^1.1.15",
		"@delightstack/rate-limiter": "^1.0.1",
		"@delightstack/styles": "^1.3.1",
		"@delightstack/utilities": "^1.3.0",
		"@delightstack/websocket": "^2.2.3",
		"hast-util-sanitize": "^5.0.2",
		"hast-util-to-html": "^9.0.6",
		"mimetext": "^3.0.28",
		"postal-mime": "^4.2.0",
		"rehype-parse": "^9.0.1",
		"unified": "^11.0.5",
		"worker-mailer": "^1.3.1",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}

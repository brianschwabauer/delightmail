{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"types": ["@cloudflare/workers-types"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"verbatimModuleSyntax": false
	},
	"include": [
		"src/**/*.ts",
		"../src/lib/schema.ts",
		"../src/lib/mail/**/*.ts"
	]
}
